{
  "name": "stackpad",
  "version": "2.2.0",
  "description": "StackPad is a lightweight notepad for Windows and Linux with vertical tabs, tab groups, window size presets and a clean light/dark theme.",
  "homepage": "https://getstackpad.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/arafatanam/StackPad.git"
  },
  "bugs": {
    "url": "https://github.com/arafatanam/StackPad/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:store": "electron-builder --win appx"
  },
  "author": {
    "name": "Arafat Anam Chowdhury",
    "email": "arafatanam@users.noreply.github.com",
    "url": "https://github.com/arafatanam"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.stackpad.app",
    "productName": "StackPad",
    "copyright": "Copyright (c) 2026 Arafat Anam Chowdhury",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "build/icon.*"
    ],
    "fileAssociations": [
      {
        "ext": "txt",
        "name": "Text Document",
        "description": "Text Document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "StackPad.v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StackPad",
      "uninstallDisplayName": "StackPad",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "StackPad.v${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "stackpad",
      "synopsis": "A lightweight notepad with vertical tabs",
      "description": "StackPad is a lightweight plain-text notepad with a vertical tab rail, tab groups, window size presets, find and replace, and a light/dark theme. Every tab is kept between sessions.",
      "maintainer": "Arafat Anam Chowdhury <arafatanam@users.noreply.github.com>",
      "vendor": "Arafat Anam Chowdhury",
      "mimeTypes": [
        "text/plain"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "StackPad",
          "Keywords": "text;editor;notepad;notes;tabs;"
        }
      },
      "artifactName": "StackPad.v${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arafatanam",
        "repo": "StackPad",
        "releaseType": "release"
      }
    ],
    "appx": {
      "applicationId": "StackPad",
      "identityName": "REPLACE.WITH.PARTNER.CENTER.IDENTITY.NAME",
      "publisher": "CN=REPLACE-WITH-PARTNER-CENTER-PUBLISHER-ID",
      "publisherDisplayName": "Arafat Anam Chowdhury",
      "displayName": "StackPad",
      "backgroundColor": "#1e3a8a",
      "languages": [
        "en-US"
      ],
      "artifactName": "StackPad.v${version}.${ext}",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    },
    "deb": {
      "artifactName": "StackPad.v${version}.${ext}"
    }
  }
}
