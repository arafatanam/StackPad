{
  "name": "stackpad",
  "version": "2.1.0",
  "description": "StackPad is a lightweight desktop notepad with vertical tabs, window size presets and a clean light/dark theme.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Arafat Anam Chowdhury",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.stackpad.app",
    "productName": "StackPad",
    "copyright": "Copyright (c) 2026 Arafat Anam Chowdhury",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.*"
    ],
    "fileAssociations": [
      {
        "ext": "txt",
        "name": "Text Document",
        "description": "Text Document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "StackPad v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StackPad",
      "uninstallDisplayName": "StackPad",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "stackpad",
      "artifactName": "StackPad-${version}.${ext}"
    }
  }
}
